# VPS Fleet Monitor - Environment Configuration
# Copy this file to .env and replace secrets with strong production values.

# ---------------------------------------------------------------------------
# Backend & Security
# ---------------------------------------------------------------------------
PROJECT_NAME="VPS Fleet Monitor"
ENVIRONMENT="production"       # development | production
DEBUG=false

# Generate with: openssl rand -hex 32
SECRET_KEY="replace-this-with-a-64-character-random-hex-secret-key-min-32-bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Admin User created on first migration/seed
FIRST_ADMIN_USERNAME="admin"
FIRST_ADMIN_EMAIL="admin@fleet.local"
# MUST BE CHANGED IMMEDIATELY IN PRODUCTION
FIRST_ADMIN_PASSWORD="ChangeMe_FleetAdmin2026!"

# Allowed CORS Origins (comma separated). E.g.: https://monitor.yourdomain.com,http://localhost:5173
CORS_ORIGINS="http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite default for ultra-simple zero-dependency local dev / single host
# For PostgreSQL in Docker or standalone:
# DATABASE_URL="postgresql+asyncpg://fleet_user:fleet_secure_pass@localhost:5432/fleet_monitor"
DATABASE_URL="sqlite+aiosqlite:///./fleet_monitor.db"

# ---------------------------------------------------------------------------
# Fleet Monitoring Defaults
# ---------------------------------------------------------------------------
HEARTBEAT_INTERVAL_SECONDS=15
SERVER_DELAYED_THRESHOLD_SECONDS=35
SERVER_OFFLINE_THRESHOLD_SECONDS=60
METRIC_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Alerting Channels (Optional)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
